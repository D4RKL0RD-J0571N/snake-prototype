:root {
    --accent: rgb(0, 255, 150);
    --alert: rgb(255, 50, 50);
    --bg-dark: rgba(0, 0, 0, 0.8);
}

.hud-layer {
    width: 100%;
    height: 100%;
    justify-content: space-between;
}

.hud-top-left {
    padding: 20px;
    width: 300px;
}

.hud-text {
    font-size: 32px;
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent);
    -unity-font-style: bold;
}

.hud-bar .unity-progress-bar__progress {
    background-color: var(--alert);
}

.hud-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: var(--accent);
    border-width: 1px;
}

.alert-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(50, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
    display: none;
}

.alert-text {
    font-size: 64px;
    color: var(--alert);
    -unity-font-style: bold;
    text-shadow: 0 0 30px var(--alert);
    margin-bottom: 20px;
    text-align: center;
}

.sub-text {
    font-size: 48px;
    color: white;
    margin-bottom: 40px;
}

.button-container {
    flex-direction: row;
    margin-top: 20px;
}

.hud-button {
    font-size: 24px;
    color: black;
    background-color: var(--accent);
    border-width: 0;
    margin: 10px;
    padding: 10px 20px;
    -unity-font-style: bold;
    border-radius: 5px;
    transition: 0.1s;
}

.hud-button:hover {
    background-color: white;
    scale: 1.1;
}

.hud-button:active {
    background-color: rgb(0, 200, 100);
}

.palette-preview-row {
    flex-direction: row;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
}

.color-chip {
    width: 60px;
    height: 60px;
    margin: 10px;
    border-radius: 30px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
}

/* Transitions */
.ui-fade-in {
    opacity: 0;
    transition: opacity 0.5s ease-out;
}

.ui-fade-in.active {
    opacity: 1;
}

.level-title-anim {
    scale: 0.5;
    transition: scale 0.8s ease-out-back, opacity 0.5s ease-out;
}

.level-title-anim.active {
    scale: 1;
    opacity: 1;
}

