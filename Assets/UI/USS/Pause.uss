/* Pause.uss - NeonTerminal Theme */

.pause-background {
    background-color: rgba(0, 5, 0, 0.85);
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    /* Neon glow border */
    border-color: #00ff00;
    border-width: 2px;
}

.pause-container {
    width: 50%;
    max-width: 600px;
    padding: 30px;
    background-color: #000a00;
    border-width: 1px;
    border-color: #00ff00;
    align-items: center;
}

.pause-header {
    margin-bottom: 30px;
    align-items: center;
}

.pause-title {
    font-size: 48px;
    color: #00ff00;
    -unity-font-style: bold;
    letter-spacing: 4px;
    text-shadow: 0 0 10px #00ff00;
}

.pause-subtitle {
    font-size: 14px;
    color: #008800;
    margin-top: 5px;
}

.button-group {
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.pause-button {
    width: 250px;
    height: 50px;
    margin: 8px;
    background-color: transparent;
    border-color: #00ff00;
    border-width: 1px;
    color: #00ff00;
    font-size: 20px;
    transition-duration: 0.1s;
}

.pause-button:hover {
    background-color: #00ff00;
    color: #000000;
}

.pause-button:active {
    background-color: #00aa00;
    border-color: #00aa00;
}

/* ASCII lines for thematic feel */
.ascii-divider {
    height: 1px;
    background-color: #00ff00;
    width: 100%;
    margin: 15px 0;
    opacity: 0.5;
}
