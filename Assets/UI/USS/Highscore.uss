/* NES-style Highscore Display */
.highscore-screen {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.9);
    unity-background-scale-mode: scale-and-crop;
}

.nes-title {
    font-size: 32px;
    font-weight: bold;
    color: #FFFFFF;
    margin-bottom: 30px;
    text-align: center;
    letter-spacing: 4px;
    text-shadow: 2px 2px 0px #FF0000;
    border: 4px solid #FFFFFF;
    padding: 10px 20px;
    background-color: #000000;
}

.highscore-scroll {
    width: 600px;
    height: 400px;
    border: 4px solid #FFFFFF;
    background-color: #000000;
    margin-bottom: 20px;
}

.highscore-entry {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 16px;
    border-bottom: 2px solid #404040;
    background-color: #202020;
}

.highscore-entry:hover {
    background-color: #404040;
}

.rank {
    font-size: 18px;
    font-weight: bold;
    color: #FFD700; /* Gold */
    width: 40px;
    text-align: center;
    font-family: "Courier New", monospace;
}

.player-name {
    font-size: 16px;
    color: #FFFFFF;
    width: 120px;
    font-family: "Courier New", monospace;
    letter-spacing: 1px;
}

.score {
    font-size: 18px;
    font-weight: bold;
    color: #00FF00; /* NES green */
    width: 100px;
    text-align: right;
    font-family: "Courier New", monospace;
}

.level {
    font-size: 16px;
    color: #00FFFF; /* Cyan */
    width: 60px;
    text-align: center;
    font-family: "Courier New", monospace;
}

.rank-title {
    font-size: 14px;
    color: #FF6B6B; /* Orange/Red */
    width: 80px;
    text-align: center;
    font-weight: bold;
    font-family: "Courier New", monospace;
}

.no-scores {
    font-size: 18px;
    color: #808080;
    text-align: center;
    padding: 40px;
    font-family: "Courier New", monospace;
    letter-spacing: 2px;
}

.button-row {
    flex-direction: row;
    gap: 20px;
    margin-top: 10px;
}

.nes-button {
    width: 120px;
    height: 40px;
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
    background-color: #000000;
    border: 3px solid #FFFFFF;
    font-family: "Courier New", monospace;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.1s ease;
}

.nes-button:hover {
    background-color: #404040;
    transform: scale(1.05);
}

.nes-button:active {
    background-color: #FFFFFF;
    color: #000000;
    transform: scale(0.95);
}

/* Responsive scaling */
@media (max-width: 800px) {
    .highscore-screen {
        padding: 10px;
    }
    
    .highscore-scroll {
        width: 90vw;
        height: 60vh;
    }
    
    .nes-title {
        font-size: 24px;
        margin-bottom: 20px;
    }
    
    .highscore-entry {
        padding: 6px 12px;
    }
    
    .rank, .player-name, .score, .level, .rank-title {
        font-size: 14px;
    }
    
    .nes-button {
        width: 100px;
        height: 35px;
        font-size: 14px;
    }
}
