/* Highscore.uss - Neon-Terminal Theme */

.highscore-screen {
    background-color: rgba(0, 5, 0, 0.95);
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    border-color: #00ff00;
    border-width: 2px;
}

.highscore-container {
    width: 70%;
    max-width: 900px;
    padding: 30px;
    background-color: #000a00;
    border-width: 1px;
    border-color: #00ff00;
}

.highscore-title {
    font-size: 48px;
    color: #00ff00;
    -unity-font-style: bold;
    letter-spacing: 4px;
    text-shadow: 0 0 10px #00ff00;
    margin-bottom: 20px;
    text-align: center;
}

.highscore-scroll {
    height: 450px;
    margin-bottom: 20px;
    border-color: rgba(0, 255, 0, 0.2);
    border-width: 1px;
}

.highscore-entry {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 255, 0, 0.1);
}

.rank {
    width: 50px;
    color: #008800;
    font-size: 20px;
}

.player-name {
    flex-grow: 1;
    color: #00ff00;
    font-size: 20px;
}

.score {
    width: 150px;
    color: #00ff00;
    font-size: 22px;
    -unity-text-align: middle-right;
}

.level {
    width: 80px;
    color: #00cc00;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.rank-title {
    width: 120px;
    color: #00ff00;
    font-size: 14px;
    opacity: 0.7;
}

.no-scores {
    color: #004400;
    font-size: 24px;
    text-align: center;
    margin-top: 50px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    gap: 20px;
}

.terminal-button {
    width: 200px;
    height: 50px;
    background-color: transparent;
    border-color: #00ff00;
    border-width: 1px;
    color: #00ff00;
    font-size: 20px;
    transition-duration: 0.1s;
}

.terminal-button:hover {
    background-color: #00ff00;
    color: #000000;
}

.terminal-button:active {
    background-color: #00aa00;
    border-color: #00aa00;
}

.ascii-divider {
    height: 1px;
    background-color: #00ff00;
    width: 100%;
    margin: 10px 0;
    opacity: 0.3;
}
