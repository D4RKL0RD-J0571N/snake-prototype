<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project:/Assets/UI/USS/HUD.uss" />
    <ui:Style src="project:/Assets/UI/USS/AlertMeter.uss" />
    
    <ui:VisualElement name="HUD" class="hud-layer">
        <!-- Top Left: Score & Detection -->
        <ui:VisualElement class="hud-top-left">
            <ui:Label name="ScoreLabel" text="SCORE: 0" class="hud-text" />
            
            <!-- Phase 3 Alert Meter -->
            <ui:VisualElement name="AlertMeterContainer" class="alert-meter-root">
                <ui:VisualElement name="MeterHeader" class="meter-header">
                    <ui:Label text="DETECTION STATUS" class="meter-title" />
                    <ui:Label name="DetectionValue" text="0%" class="meter-value" />
                </ui:VisualElement>
                <ui:VisualElement name="MeterTrack" class="meter-track">
                    <ui:VisualElement name="MeterFill" class="meter-fill" style="width: 0%;" />
                </ui:VisualElement>
                <ui:Label text="SCANNING..." name="StatusText" class="status-tip" />
            </ui:VisualElement>

            <ui:ProgressBar name="EnergyBar" title="DETECTION: 0%" value="0" high-value="100" class="hud-bar" style="display: none;" />
        </ui:VisualElement>

        <!-- Full Screen Overlay (Hidden by default) -->
        <ui:VisualElement name="AlertOverlay" class="alert-overlay" style="display: none;">
            <ui:Label name="AlertHeader" text="SYSTEM FAILURE" class="alert-text" />
            <ui:Label name="AlertSubHeader" text="GAME OVER" class="alert-text sub-text" />
            
            <ui:VisualElement class="button-container">
                <ui:Button name="RespawnButton" text="REBOOT SYSTEM" class="hud-button" />
                <ui:Button name="QuitButton" text="TERMINATE" class="hud-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Phase 4: Level Intro Screen -->
        <ui:VisualElement name="LevelIntro" class="alert-overlay" style="display: none; background-color: rgba(0, 0, 0, 0.95);">
            <ui:Label name="IntroTitle" text="LEVEL 01" class="alert-text" style="color: rgb(0, 255, 255);" />
            <ui:Label name="IntroGoal" text="COLLECT 5 CORES" class="alert-text sub-text" />
            <ui:Label name="IntroDifficulty" text="DIFFICULTY: EASY" class="alert-text sub-text" style="font-size: 24px; opacity: 0.7;" />
            
            <ui:VisualElement name="PalettePreview" class="palette-preview-row">
                <ui:VisualElement class="color-chip" name="Chip1" />
                <ui:VisualElement class="color-chip" name="Chip2" />
                <ui:VisualElement class="color-chip" name="Chip3" />
                <ui:VisualElement class="color-chip" name="Chip4" />
            </ui:VisualElement>

            <ui:VisualElement class="button-container" style="margin-top: 40px;">
                <ui:Button name="BeginButton" text="INITIALIZE" class="hud-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
